#!/usr/bin/make -f
# The loopback test of tests/ runs in the build (make check).
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export DPKG_EXPORT_BUILDFLAGS = 1
include /usr/share/dpkg/buildflags.mk
include /usr/share/dpkg/architecture.mk

%:
	dh $@

override_dh_auto_test:
	$(MAKE) check

override_dh_auto_install:
	$(MAKE) install DESTDIR=$(CURDIR)/debian/tmp libdir=/usr/lib/$(DEB_HOST_MULTIARCH)

# Names the first version that exports flush() and the two epoll helpers.
override_dh_makeshlibs:
	dh_makeshlibs -V 'libudt0 (>= 4.13)'
